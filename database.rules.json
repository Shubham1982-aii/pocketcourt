{
  "rules": {
    "rooms": {
      "$roomId": {
        ".read": true,
        ".write": "!data.exists() || root.child('rooms/' + $roomId + '/status').val() != 'SEALED_FINAL'",
        "participants": {
          "$role": {
            ".write": true
          }
        },
        "floorSpeaker": {
          ".write": true
        },
        "activeObjection": {
          ".write": true
        },
        "witnessPass": {
          ".write": true
        },
        "crowdVotes": {
          ".write": true
        },
        "messages": {
          ".write": "root.child('rooms/' + $roomId + '/status').val() != 'SEALED_FINAL'"
        },
        "evidence": {
          ".write": "root.child('rooms/' + $roomId + '/status').val() != 'SEALED_FINAL'"
        },
        "verdict": {
          ".write": "data.child('isFinal').val() != true || newData.child('penaltyFulfilled').exists()"
        }
      }
    }
  }
}
